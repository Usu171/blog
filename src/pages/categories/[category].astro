---
import { getCollection } from "astro:content";
import GroupedPostListPage from "@components/GroupedPostListPage.astro";
import { categoryGroupConfig, getGroupedFirstPageProps, getGroupedStaticPaths } from "@/grouped-posts.ts";

export async function getStaticPaths() {
  return getGroupedStaticPaths(await getCollection("blog"), categoryGroupConfig);
}

const pageProps = await getGroupedFirstPageProps(Astro.props);
---

<GroupedPostListPage {...pageProps} />
