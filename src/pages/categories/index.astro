---
import { getCollection } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";
import ButtonList from "@components/ButtonList.astro";
import { categoryGroupConfig, getGroupedIndexItems } from "@/grouped-posts.ts";
const allPosts = await getCollection("blog");

const title = categoryGroupConfig.title;
const categoryCounts = getGroupedIndexItems(allPosts, categoryGroupConfig);
---

<BaseLayout title={title}>
  <ButtonList title={title} items={categoryCounts} url={categoryGroupConfig.basePath.slice(1)} />
</BaseLayout>
