---
import { getCollection } from "astro:content";
import ButtonList from "@components/ButtonList.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { getGroupedIndexItems, tagGroupConfig } from "@/grouped-posts.ts";

const allPosts = await getCollection("blog");

const title = tagGroupConfig.title;
const tagCounts = getGroupedIndexItems(allPosts, tagGroupConfig);
---

<BaseLayout title={title}>
  <ButtonList title={title} items={tagCounts} url={tagGroupConfig.basePath.slice(1)} />
</BaseLayout>
