---
import { getCollection } from "astro:content";
import GroupedPostListPage from "@components/GroupedPostListPage.astro";
import { getGroupedFirstPageProps, getGroupedStaticPaths, tagGroupConfig } from "@/grouped-posts.ts";

export async function getStaticPaths() {
  return getGroupedStaticPaths(await getCollection("blog"), tagGroupConfig);
}

const pageProps = await getGroupedFirstPageProps(Astro.props);
---

<GroupedPostListPage {...pageProps} />
