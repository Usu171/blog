---
import { getCollection } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";
import PostList from "@components/PostList.astro";
import { POSTS_PER_PAGE, processPosts } from "@/utils.ts";

const processedPosts = processPosts(await getCollection("blog"));
const lastPage = Math.ceil(processedPosts.length / POSTS_PER_PAGE);
---


<BaseLayout>
  <PostList
    posts={processedPosts.slice(0, POSTS_PER_PAGE)}
    currentPage={1}
    lastPage={lastPage}
  />
</BaseLayout>
