---
import { getCollection } from "astro:content";
import GroupedPostListPage from "@components/GroupedPostListPage.astro";
import { archiveGroupConfig, getGroupedPaginatedStaticPaths } from "@/grouped-posts.ts";

export async function getStaticPaths({ paginate }) {
  return getGroupedPaginatedStaticPaths(
    await getCollection("blog"),
    archiveGroupConfig,
    paginate
  );
}

const { page, groupValue, totalCount, pageBasePath } = Astro.props;
---

<GroupedPostListPage
  groupValue={groupValue}
  totalCount={totalCount}
  pageBasePath={pageBasePath}
  posts={page.data}
  currentPage={page.currentPage}
  lastPage={page.lastPage}
/>
