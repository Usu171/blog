---
import { getCollection } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";
import PostList from "@components/PostList.astro";
import { POSTS_PER_PAGE, processPosts } from "src/utils.ts";

export async function getStaticPaths({ paginate }) {
  const allPosts = await getCollection("blog");
  const uniqueYears = [...new Set(allPosts.map((post) => new Date(post.data.date).getFullYear()))];

  return uniqueYears.flatMap((year) => {
    const processedPosts = processPosts(
      allPosts.filter((post) => new Date(post.data.date).getFullYear() === year)
    );

    return paginate(processedPosts, {
      pageSize: POSTS_PER_PAGE,
      params: { year: String(year) },
      props: {
        year: String(year),
        totalCount: processedPosts.length,
      },
    });
  });
}

const { page, year, totalCount } = Astro.props;
---

<BaseLayout title={year}>
  <h1 class="text-textColor dark:text-textColordark ml-4">{year} ({totalCount})</h1>
  <PostList
    posts={page.data}
    currentPage={page.currentPage}
    lastPage={page.lastPage}
    pageBasePath={`/archives/${year}`}
  />
</BaseLayout>
