---
import { getCollection } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";
import PostList from "@components/PostList.astro";
import { POSTS_PER_PAGE, processPosts } from "@/utils.ts";

export async function getStaticPaths() {
  const allPosts = await getCollection("blog");

  const uniqueYears = [...new Set(allPosts
    .map((post) => new Date(post.data.date).getFullYear())
  )];

  return uniqueYears.map((year) => {
    const filteredPosts = allPosts.filter((post) => new Date(post.data.date).getFullYear() === year);

    return {
      params: { year: String(year) },
      props: { posts: filteredPosts },
    };
  });
}

const { year } = Astro.params;
const { posts } = Astro.props;
const processedPosts = await processPosts(posts);
const lastPage = Math.ceil(processedPosts.length / POSTS_PER_PAGE);
---

<BaseLayout title={year}>
  <h1 class="text-textColor dark:text-textColordark ml-4">{year} ({posts.length})</h1>
  <PostList
    posts={processedPosts.slice(0, POSTS_PER_PAGE)}
    currentPage={1}
    lastPage={lastPage}
    pageBasePath={`/archives/${year}`}
  />
</BaseLayout>
