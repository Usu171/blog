---
import { getCollection } from "astro:content";
import ButtonList from "@components/ButtonList.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { archiveGroupConfig, getGroupedIndexItems } from "@/grouped-posts.ts";

const allPosts = await getCollection("blog");

const title = archiveGroupConfig.title;
const yearArray = getGroupedIndexItems(allPosts, archiveGroupConfig);
---

<BaseLayout title={title}>
  <ButtonList title={title} items={yearArray} url={archiveGroupConfig.basePath.slice(1)} />
</BaseLayout>
