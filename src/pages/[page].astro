---
import { getCollection } from "astro:content";
import PostList from "@components/PostList.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { POSTS_PER_PAGE, processPosts } from "@/utils.ts";

export async function getStaticPaths({ paginate }) {
  const processedPosts = await processPosts(await getCollection("blog"));

  return paginate(processedPosts, {
    pageSize: POSTS_PER_PAGE,
  });
}

const { page } = Astro.props;
---

<BaseLayout> <PostList posts={page.data} currentPage={page.currentPage} lastPage={page.lastPage} /> </BaseLayout>
